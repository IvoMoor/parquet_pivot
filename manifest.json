{
  "name": "Parquet Pivot",
  "short_name": "Parquet Pivot",
  "description": "Excel-style pivot tables on Parquet files, fully local.",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#217346",
  "theme_color": "#217346",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./app.html",
      "name": "Parquet file",
      "accept": {
        "application/vnd.apache.parquet": [".parquet"],
        "application/octet-stream": [".parquet", ".pq"]
      }
    }
  ]
}
